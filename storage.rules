rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Mọi người đều có thể nghe audio và tải cover
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'xuankensinger@gmail.com' ||
        request.auth.token.admin == true
      );
    }
  }
}
